version: '3.9'

# ==================== Docker Compose pour Développement ====================
# Inclut hot reload du code et mount volumes pour développement local
# Usage: docker-compose -f docker-compose-dev.yml up

services:
  # ==================== PostgreSQL ====================
  postgres:
    image: postgres:16-alpine
    container_name: lexia-postgres-dev
    environment:
      POSTGRES_USER: lexia_user
      POSTGRES_PASSWORD: dev_password
      POSTGRES_DB: lexia_db
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=en_US.UTF-8"
    ports:
      - "5432:5432"
    volumes:
      - postgres_data_dev:/var/lib/postgresql/data
      - ./init-db.sql:/docker-entrypoint-initdb.d/init.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U lexia_user -d lexia_db"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - lexia-dev-network
    restart: unless-stopped

  # ==================== Ollama (LLM Local) ====================
  ollama:
    image: ollama/ollama:latest
    container_name: lexia-ollama-dev
    environment:
      OLLAMA_HOST: 0.0.0.0:11434
    ports:
      - "11434:11434"
    volumes:
      - ollama_data_dev:/root/.ollama
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:11434/api/tags"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - lexia-dev-network
    restart: unless-stopped

  # ==================== Qdrant (Vector Store) ====================
  qdrant:
    image: qdrant/qdrant:latest
    container_name: lexia-qdrant-dev
    environment:
      QDRANT_API_KEY: dev-key-insecure
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant_data_dev:/qdrant/storage
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:6333/health"]
      interval: 30s
      timeout: 10s
      retries: 3
    networks:
      - lexia-dev-network
    restart: unless-stopped

  # ==================== FastAPI Backend (Développement) ====================
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: lexia-backend-dev
    environment:
      DEBUG: "true"
      PORT: 8080
      DATABASE_URL: postgresql://lexia_user:dev_password@localhost:5432/lexia_db
      OLLAMA_BASE_URL: http://ollama:11434
      OLLAMA_LLM_MODEL: mistral
      OLLAMA_EMBEDDING_MODEL: nomic-embed-text
      QDRANT_HOST: qdrant
      QDRANT_PORT: 6333
      QDRANT_COLLECTION: lexia_chunks_dev
      CHUNK_SIZE: 1000
      CHUNK_OVERLAP: 200
      MAX_CHUNKS_PER_SEARCH: 5
      AI_TIMEOUT_SECONDS: 120
      PYTHONUNBUFFERED: 1
      PYTHONDONTWRITEBYTECODE: 1

    ports:
      - "8080:8080"

    depends_on:
      postgres:
        condition: service_healthy
      ollama:
        condition: service_healthy
      qdrant:
        condition: service_healthy

    volumes:
      # Mount du code pour hot reload
      - ./app:/app

      # Logs visibles localement
      - ./logs:/app/logs

      # Cache pip
      - pip_cache:/root/.cache/pip

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

    networks:
      - lexia-dev-network

    restart: unless-stopped

    # Mode dev: pas de limites strictes
    deploy:
      resources:
        limits:
          cpus: '4'
          memory: 8G

  # ==================== PgAdmin (Gestion DB) ====================
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: lexia-pgadmin-dev
    environment:
      PGADMIN_DEFAULT_EMAIL: dev@lexia.local
      PGADMIN_DEFAULT_PASSWORD: dev
      SCRIPT_NAME: /pgadmin
    ports:
      - "5050:80"
    depends_on:
      - postgres
    networks:
      - lexia-dev-network
    restart: unless-stopped

  # ==================== Redis (Cache - Optionnel) ====================
  redis:
    image: redis:7-alpine
    container_name: lexia-redis-dev
    ports:
      - "6379:6379"
    volumes:
      - redis_data_dev:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - lexia-dev-network
    restart: unless-stopped

  # ==================== API Tester (Optionnel - REST Client) ====================
  # Pour tester l'API depuis un conteneur
  test:
    image: curlimages/curl:latest
    container_name: lexia-test
    depends_on:
      - backend
    networks:
      - lexia-dev-network
    entrypoint: ["sh", "-c", "echo 'Ready to test. Use: docker exec lexia-test curl http://backend:8080/api/health'"]
    restart: "no"

networks:
  lexia-dev-network:
    driver: bridge

volumes:
  postgres_data_dev:
    driver: local
  ollama_data_dev:
    driver: local
  qdrant_data_dev:
    driver: local
  redis_data_dev:
    driver: local
  pip_cache:
    driver: local
