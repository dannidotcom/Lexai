# =========================
# APP CONFIG
# =========================
APP_NAME=LexIA — Moteur IA Juridique Souverain
VERSION=1.0.0
DEBUG=false
ENV=development

# =========================
# DATABASE (POSTGRES)
# =========================
POSTGRES_USER=lexia_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=lexia_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL utilisée par SQLAlchemy
DATABASE_URL=postgresql://lexia_user:change_me@postgres:5432/lexia_db

# =========================
# SECURITY / JWT
# =========================
SECRET_KEY=replace-with-a-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=30
VERIFY_EMAIL_TOKEN_EXPIRE_MINUTES=1440

COOKIE_SECURE=false
COOKIE_DOMAIN=

# =========================
# FRONTEND / CORS
# =========================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost

# =========================
# RATE LIMIT / SECURITY
# =========================
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MINUTES=15

# =========================
# SMTP EMAIL
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=security@lexia.local

# =========================
# OLLAMA (LOCAL AI)
# =========================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =========================
# QDRANT (VECTOR DB)
# =========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=lexia_chunks

# =========================
# AI / RAG SETTINGS
# =========================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_SEARCH=5
AI_TIMEOUT_SECONDS=300